#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# --- Added for clean repo / iOS handoff ---
# Build outputs / packaged apps (don't commit binaries)
*.apk
*.aab
*.ipa

# iOS (CocoaPods + Xcode user data — regenerated on the Mac via `pod install`)
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/ephemeral/
**/ios/**/*.xcworkspace/xcuserdata/
**/ios/**/xcuserdata/
**/Podfile.lock

# Android local config / signing secrets (NEVER commit)
**/android/local.properties
**/android/.gradle/
**/android/key.properties
*.jks
*.keystore

# Environment / secrets
.env
*.env

# Local, ad-hoc backend probe/seed scripts — these hold hardcoded test
# credentials and must NEVER be committed. Keep dev tooling that ships in the
# repo (render_*, generate_pdf_report, seed_patients) tracked as usual.
tool/probe_backend.js
tool/test_live_notes.js
tool/seed_exact_patients.js
tool/check_note_gen.js
tool/check_schedule.js
tool/find_apis.js
tool/inspect_user_package.js

# Local build artifacts / screenshots (not source)
dist/
release_builds/
**/android/build/
